# zombie-army-4: copy to ".env" and fill in real values. Never commit the real .env.

# NEX identity (access key and NEX 4.6.6 read from the 1.1.1 main binary)
ZA4_ACCESS_KEY=dd3825ac
ZA4_NEX_VERSION=40606

# Wire-shape knobs
ZA4_STATION_SCHEME=prudps
ZA4_SECURE_MINOR=0
ZA4_LEGACY_PIA=0

# Network (NEXTENDO_HOST is the bare public IP the console dials)
NEXTENDO_HOST=127.0.0.1
AUTH_PORT=8468
SECURE_PORT=60030
NEXTENDO_PROXY_PROTOCOL=0
NNCS_NAT_FILE=data/nat_endpoints.txt

# TLS
CERT_FILE=cert.pem
KEY_FILE=key.pem

# Nextendo account integration
NEXTENDO_ACCOUNT_URL=http://127.0.0.1:1
NEXTENDO_REQUIRE_ACCOUNT=0
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# Marks created sessions open + active (Clubhouse/Tennis/MPS leave them closed until a later call,
# so two searchers each host and never match). Kept on until Saints Row is shown not to need it.
NEXTENDO_OPEN_PARTICIPATION=1

# Monitoring (fail-closed without a token)
DASH_PORT=8117
DASH_TOKEN=change-me
NEXTENDO_SNI_HOST=g20532500-lp1.s.n.srv.nintendo.net

# Secrets
NEXTENDO_INTERNAL_KEY=
NEXTENDO_SECRET=
NEXTENDO_SECRET_FILE=
NEXTENDO_SECURE_PASSWORD=securepasswordplz1
